# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---------- Virtual environments ----------
venv/
.venv/
env/

# ---------- Data ----------
# Raw data is large and licensed by its Kaggle publisher.
# Processed data is fully regenerable: `python run_pipeline.py`.
# The folders survive because of the .gitkeep files.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# ---------- Secrets ----------
.env
*.key
secrets.*
.streamlit/secrets.toml

# ---------- OS / editor noise ----------
Thumbs.db
desktop.ini
.DS_Store
.vscode/settings.json

# ---------- NOT ignored, on purpose ----------
# models/       the deployed app needs the .joblib at runtime (1.6 MB)
# reports/      the findings documents are the readable part of this project
# reports/figures/  embedded in the README
